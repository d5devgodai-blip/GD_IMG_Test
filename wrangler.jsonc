{
  // Static image CDN for the Dify manual knowledge base.
  //
  // Replaces jsDelivr, which refuses to serve this repo at all: it caps a package
  // at 50 MB and GD_IMG_Test is ~168 MB (see CLAUDE.md "Images & CDN" blocker).
  //
  // The assets directory is the REPO ROOT on purpose. Every url in the maps is
  // "<host>/<repo path>", so mounting the root keeps the path segment after the
  // host byte-identical to the jsDelivr urls -- the pitfall-17 invariant
  // (image dir repo path == CDN url segment) is preserved and only the host moves.
  //
  // NOTE: "name" must match the Workers project already connected to this repo in
  // the Cloudflare dashboard, otherwise `wrangler deploy` creates a SECOND worker.
  "name": "gd-img-test",
  "compatibility_date": "2026-08-19",
  "assets": {
    "directory": "./",
    // Serve paths exactly as requested: no /foo -> /foo/index.html rewriting,
    // no trailing-slash redirects. A url must map 1:1 onto a repo path.
    "html_handling": "none",
    // Miss -> plain 404, so a broken image url fails loudly instead of
    // silently returning some fallback page.
    "not_found_handling": "none"
  }
}
