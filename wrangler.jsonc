{
  // Static image CDN for the Dify manual knowledge base, replacing jsDelivr
  // (which caps a package at 50 MB and refuses this ~178 MB repo outright).
  //
  // This is a PAGES project, deliberately not a Worker with static assets.
  // Both serve files identically, but a Workers Custom Domain requires the zone
  // to be hosted on Cloudflare, and godai.co.jp is not -- it answers from
  // ns.godai.co.jp / ns.offer.ne.jp. Pages is the only one of the two that
  // accepts a CNAME for a subdomain from an external DNS provider, so
  // img.godai.co.jp can point here without moving company DNS (and mail) to
  // Cloudflare. Same reason R2 is not viable on godai.co.jp.
  //
  // Output dir is the repo ROOT on purpose: a url path is resolved relative to
  // it, so keeping it at the root makes the published url path identical to the
  // repo path. That preserves the pitfall-17 invariant (image dir repo path ==
  // CDN url segment) and reduces the migration to swapping the host in the maps.
  "name": "gd-img-test",
  "compatibility_date": "2026-08-19",
  "pages_build_output_dir": "."
}
